CAPI=2:
name: "bhanu:soc:uart_ral"
description: "UART register model, generated by OpenTitan regtool (-s) from uart.hjson"

filesets:
  files_dv:
    depend:
      - lowrisc:dv:dv_base_reg
    files:
      - gen/uart_ral_pkg.sv
    file_type: systemVerilogSource

targets:
  default:
    filesets:
      - files_dv