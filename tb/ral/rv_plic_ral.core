CAPI=2:
name: "bhanu:soc:rv_plic_ral"
description: "rv_plic register model, generated by OpenTitan regtool (-s) from ip/rv_plic/data/rv_plic.hjson"

filesets:
  files_dv:
    depend:
      - lowrisc:dv:dv_base_reg
    files:
      - gen/rv_plic_ral_pkg.sv
    file_type: systemVerilogSource

targets:
  default:
    filesets:
      - files_dv
