CAPI=2:
name: "bhanu:soc:gpio_ral"
description: "gpio register model, generated by OpenTitan regtool (-s) from ip/gpio/data/gpio.hjson"

filesets:
  files_dv:
    depend:
      - lowrisc:dv:dv_base_reg
    files:
      - gen/gpio_ral_pkg.sv
    file_type: systemVerilogSource

targets:
  default:
    filesets:
      - files_dv
